# Copy to .env and adjust for your environment. Never commit .env.

# PostgreSQL connection used by ingestion, dbt and the dashboard
METRICFLOW_DB_HOST=localhost
METRICFLOW_DB_PORT=5432
METRICFLOW_DB_NAME=metricflow
METRICFLOW_DB_USER=metricflow
METRICFLOW_DB_PASSWORD=change-me

# Directory containing the source CSV files to ingest
METRICFLOW_DATA_DIR=data/sample

# DEBUG, INFO, WARNING or ERROR
METRICFLOW_LOG_LEVEL=INFO
